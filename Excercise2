import cv2 as cv
import os
new_directory = "/Users/stefenkaushik/"  
os.chdir(new_directory)
image = cv.imread('colormap.jpg')

if image is None:
    print("Error: Image not found.")
    exit()


image = cv.resize(image, (600, 400))

points = [(390, 30), (225, 118), (382, 262), (134, 290)]  

for i, (x, y) in enumerate(points):
    b, g, r = image[y, x]
    print(f"Point {i+1} at ({x}, {y}): RGB = ({r}, {g}, {b})")
    
    cv.circle(image, (x, y), 5, (0, 0, 255), -1)  
cv.imshow("Image with Points", image)

cv.waitKey(0)
cv.destroyAllWindows()

