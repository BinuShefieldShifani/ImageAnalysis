import cv2 as cv
import numpy as np
import os

new_directory = "/Users/stefenkaushik/"  
os.chdir(new_directory)


image = cv.imread("star.png")

if image is None:
    print("Error: Image not found.")
    exit()

gray = cv.cvtColor(image, cv.COLOR_BGR2GRAY)

blurred = cv.GaussianBlur(gray, (5, 5), 0)

canny_lower = 30 
canny_upper = 100 
edges = cv.Canny(blurred, canny_lower, canny_upper)

kernel = np.ones((3, 3), np.uint8)
edges_dilated = cv.dilate(edges, kernel, iterations=1)  
edges_refined = cv.erode(edges_dilated, kernel, iterations=1)  

contours_canny, _ = cv.findContours(edges_refined, cv.RETR_EXTERNAL, cv.CHAIN_APPROX_SIMPLE)


cx_canny, cy_canny = -1, -1
output_image_canny = image.copy()
if contours_canny:

    contours_canny = [c for c in contours_canny if cv.contourArea(c) > 100]

    if contours_canny:
        
        largest_contour_canny = max(contours_canny, key=cv.contourArea)

        M_canny = cv.moments(largest_contour_canny)
        if M_canny["m00"] != 0:
            cx_canny = int(M_canny["m10"] / M_canny["m00"])
            cy_canny = int(M_canny["m01"] / M_canny["m00"])
            print(cx_canny, cy_canny )
            cv.circle(output_image_canny, (cx_canny, cy_canny), 5, (0, 255, 0), -1)
        cv.drawContours(output_image_canny, [largest_contour_canny], -1, (0, 255, 0), 2)

# --- Using Binarization Filter ---
_, binary = cv.threshold(gray, 127, 255, cv.THRESH_BINARY_INV)

contours_binary, _ = cv.findContours(binary, cv.RETR_EXTERNAL, cv.CHAIN_APPROX_SIMPLE)

if contours_binary:
    largest_contour_binary = max(contours_binary, key=cv.contourArea)

    M_binary = cv.moments(largest_contour_binary)
    if M_binary["m00"] != 0:
        cx_binary = int(M_binary["m10"] / M_binary["m00"])
        cy_binary = int(M_binary["m01"] / M_binary["m00"])
    else:
        cx_binary, cy_binary = 0, 0

    output_image_binary = image.copy()
    print(cx_binary,cy_binary)
    cv.drawContours(output_image_binary, [largest_contour_binary], -1, (255, 0, 0), 2)
    cv.circle(output_image_binary, (cx_binary, cy_binary), 5, (0, 255, 0), -1)
    cv.imwrite("star_binary_result.png", output_image_binary)
    cv.imshow("Binarization Filter - Contours and Center", output_image_binary)
    print(f"Binarization Filter Center: ({cx_binary}, {cy_binary})")
else:
    print("No contours found using Binarization.")

cv.imshow("Refined Edges (Canny)", output_image_canny)
cv.waitKey(0)
cv.destroyAllWindows()

'''
 Canny detects edges based on intensity gradients and finds contours. 
 Binarization separates the object from the background by thresholding, then contours are found . The center coordinates (cx, cy) of the object are printed and marked on the image in both cases. 
 These methods help identify the object's position in the image by analyzing its contours.

 The code detects contours of the largest object in an image using two methods: Canny edge detection and binary thresholding, then finds and marks the center of the largest contour.
 It processes the image by converting it to grayscale, applying blurring and edge detection, and refining edges before detecting contours and calculating their centroids using image moments.
 The results are visualized by drawing contours and the center on the original image, saving or displaying the output for both methods.
 Coordinates of centroid:88,113(both canny and binary)
