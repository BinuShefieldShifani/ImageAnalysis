import cv2
import numpy as np
import os
new_directory = "/Users/stefenkaushik/"  
os.chdir(new_directory)

def calculate_orientation(contours, img, method_name):
    if len(contours) == 0:
        return None, img 
   
    largest_contour = max(contours, key=cv2.contourArea)


    rect = cv2.minAreaRect(largest_contour)
    box = cv2.boxPoints(rect)
    box = np.int0(box)

    
    cv2.drawContours(img, [box], 0, (255, 0, 0), 2) 
    cv2.drawContours(img, [largest_contour], -1, (0, 255, 0), 2)  

    angle = rect[2]
    if angle < -45:
        angle = 90 + angle  

    moments = cv2.moments(largest_contour)
    if moments["m00"] != 0:  
        center_x = int(moments["m10"] / moments["m00"])
        center_y = int(moments["m01"] / moments["m00"])
        center = (center_x, center_y)
        cv2.circle(img, center, 5, (0, 0, 255), -1)  
    else:
        center = None

   
    if center:
        
        text_x = min(box[:, 0])  
        text_y = min(box[:, 1]) - 10  

        
        if text_y < 20:  
            text_y = max(box[:, 1]) + 20  

        
        cv2.putText(img, f"{method_name}: {angle:.2f}°", 
                    (text_x, text_y), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 0), 2, cv2.LINE_AA)

    return angle, img

input_file = "tree.png" 
image = cv2.imread(input_file)
if image is None:
    raise FileNotFoundError(f"Image file '{input_file}' not found!")


gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

canny_image = image.copy()
binary_image = image.copy()

edges = cv2.Canny(gray, 50, 150)
kernel = np.ones((3, 3), np.uint8)  
edges = cv2.dilate(edges, kernel, iterations=1)  
contours, _ = cv2.findContours(edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
canny_orientation, canny_result = calculate_orientation(contours, canny_image, "Canny")

_, binary = cv2.threshold(gray, 128, 255, cv2.THRESH_BINARY_INV)
contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
binary_orientation, binary_result = calculate_orientation(contours, binary_image, "Binarization")

output = np.hstack((canny_result, binary_result))

cv2.imshow("Orientation Results", output)
cv2.imwrite("orientation_output_revised.png", output)
cv2.waitKey(0)
cv2.destroyAllWindows()

if canny_orientation is not None:
    print(f"Orientation using Canny Filter: {canny_orientation:.2f} degrees")
else:
    print("Canny Filter: No valid contours found.")

if binary_orientation is not None:
    print(f"Orientation using Binarization: {binary_orientation:.2f} degrees")
else:
    print("Binarization: No valid contours found.")

'''
The script uses two methods to find the orientation of an object in an image: 
Canny edge detection and binarization. Both methods identify the contours of the object, and the orientation is calculated by fitting a rotated rectangle to the largest contour. 
The angle of the rectangle gives the object's orientation in degrees. Canny edge detection highlights edges based on intensity changes, while binarization separates the object from the background by thresholding. 
The orientation angles:68.60(canny) 68.86(binary)
