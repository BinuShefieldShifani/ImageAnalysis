import cv2
import numpy as np
import cv2.aruco as aruco

# Function to enhance the contrast of the V channel in an HSV image using CLAHE
def enhance_contrast(hsv_image):
    # Extract the V (value) channel from the HSV image
    v_channel = hsv_image[:, :, 2]
    # Create a CLAHE object for contrast enhancement
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    # Apply CLAHE to the V channel
    hsv_image[:, :, 2] = clahe.apply(v_channel)
    return hsv_image

# Function to calculate the percentage of a specific color in a masked HSV image
def color_percentage(masked_hsv, lower, upper, mask):
    # Create a binary mask for the color range
    color_mask = cv2.inRange(masked_hsv, lower, upper)
    # Count non-zero pixels in the color mask
    color_pixels = cv2.countNonZero(color_mask)
    # Count non-zero pixels in the provided mask
    total_pixels = cv2.countNonZero(mask)
    # Return the percentage of color pixels, avoiding division by zero
    return color_pixels / total_pixels if total_pixels > 0 else 0

# Function to detect the dominant color within a given contour
def detect_color_in_contour(frame, contour):
    # Create a mask for the given contour
    mask = np.zeros(frame.shape[:2], dtype=np.uint8)
    cv2.drawContours(mask, [contour], -1, 255, -1)

    # Apply Gaussian blur to smooth the frame
    frame_blurred = cv2.GaussianBlur(frame, (5, 5), 0)
    # Convert the frame to HSV color space
    hsv = cv2.cvtColor(frame_blurred, cv2.COLOR_BGR2HSV)

    # Define HSV ranges for different colors
    red_lower1 = np.array([0, 100, 100])
    red_upper1 = np.array([10, 255, 255])
    red_lower2 = np.array([160, 100, 100])
    red_upper2 = np.array([180, 255, 255])
    white_lower = np.array([0, 0, 200])
    white_upper = np.array([180, 50, 255])
    blue_lower = np.array([100, 150, 50])
    blue_upper = np.array([140, 255, 255])
    green_lower = np.array([40, 50, 50])
    green_upper = np.array([90, 255, 255])
    yellow_lower = np.array([20, 100, 100])
    yellow_upper = np.array([30, 255, 255])
    black_lower = np.array([0, 0, 0])
    black_upper = np.array([180, 255, 50])

    # Mask the HSV image using the contour mask
    masked_hsv = cv2.bitwise_and(hsv, hsv, mask=mask)

    # Check for the presence of each color by calculating the percentage
    if color_percentage(masked_hsv, red_lower1, red_upper1, mask) > 0.1 or \
       color_percentage(masked_hsv, red_lower2, red_upper2, mask) > 0.1:
        return "Red"
    elif color_percentage(masked_hsv, white_lower, white_upper, mask) > 0.1:
        return "White"
    elif color_percentage(masked_hsv, blue_lower, blue_upper, mask) > 0.1:
        return "Blue"
    elif color_percentage(masked_hsv, green_lower, green_upper, mask) > 0.1:
        return "Green"
    elif color_percentage(masked_hsv, yellow_lower, yellow_upper, mask) > 0.1:
        return "Yellow"
    elif color_percentage(masked_hsv, black_lower, black_upper, mask) > 0.1:
        return "Black"

    return None

# Function to expand the region of interest (ROI) around a detected ArUco marker
def expand_roi(corners, frame, padding_factor=30):
    x_min = int(np.min(corners[:, 0]))
    y_min = int(np.min(corners[:, 1]))
    x_max = int(np.max(corners[:, 0]))
    y_max = int(np.max(corners[:, 1]))

    # Add padding to the bounding box, ensuring it stays within frame bounds
    x_min = max(0, x_min - padding_factor)
    y_min = max(0, y_min - padding_factor)
    x_max = min(frame.shape[1], x_max + padding_factor)
    y_max = min(frame.shape[0], y_max + padding_factor)

    return x_min, y_min, x_max, y_max

# Function to detect and classify needles within a masked area of the frame
def detect_needles(frame, mask, pixel_to_mm):
    # Normalize the frame using the mask
    frame_norm = cv2.bitwise_and(frame, frame, mask=mask)
    gray = cv2.cvtColor(frame_norm, cv2.COLOR_BGR2GRAY)
    gray = cv2.normalize(gray, None, 0, 255, cv2.NORM_MINMAX)

    # Save intermediate images for debugging
    cv2.imwrite("grayimage.jpg", gray)

    # Apply adaptive thresholding to highlight needle-like shapes
    thresh = cv2.adaptiveThreshold(
        gray, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY, 11, 2)
    blurred = cv2.medianBlur(thresh, 5)
    cv2.imwrite("blurimage.jpg", blurred)

    # Apply bilateral filter for noise reduction
    bilateral_filter = cv2.bilateralFilter(blurred, 5, 50, 50)
    cv2.imwrite("biimage.jpg", bilateral_filter)

    # Detect edges using the Canny edge detector
    edges = cv2.Canny(bilateral_filter, 50, 250)
    cv2.imwrite("cannyimage.jpg", edges)

    # Apply morphological operations to refine edges
    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))
    edges = cv2.dilate(edges, kernel, iterations=1)
    cv2.imwrite("morphimage.jpg", edges)

    # Find contours from the edges
    contours, _ = cv2.findContours(edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    # Filter contours based on area
    MIN_AREA = 1000
    filtered_contours = [cnt for cnt in contours if cv2.contourArea(cnt) > MIN_AREA]
    cv2.drawContours(gray, filtered_contours, -1, (0, 255, 0), 2)
    cv2.imwrite("contourimage.jpg", gray)

    # Initialize counters for needle detection
    needle_count = 0
    small_needles = 0
    large_needles = 0
    detected_contours = []

    # Loop through each contour to analyze and classify
    for contour in filtered_contours:
        x, y, w, h = cv2.boundingRect(contour)
        needle_length_pixels = max(w, h)

        if pixel_to_mm:
            needle_length_mm = needle_length_pixels / pixel_to_mm
        else:
            continue

        # Classify needles based on length and head size
        if 19 <= needle_length_mm <= 26:
            needle_count += 1
            head_roi = frame[y:y + h // 4, x:x + w] if h >= 4 else frame[y:y + h, x:x + w]
            color = detect_color_in_contour(frame, contour)
            label = f"Needle {needle_count}: {color} Head"
            cv2.putText(frame, label, (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 2)

    # Display summary information on the frame
    summary = f"Total Needles: {needle_count}, Small: {small_needles}, Large: {large_needles}"
    cv2.putText(frame, summary, (10, frame.shape[0] - 20), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 255), 2)
    cv2.imshow("Needle Detection", frame)

# Main function for detecting needles in real-time with ArUco markers as a reference
def main():
    aruco_dict = cv2.aruco.getPredefinedDictionary(cv2.aruco.DICT_4X4_50)
    parameters = cv2.aruco.DetectorParameters()
    aruco_detector = cv2.aruco.ArucoDetector(aruco_dict, parameters)

    # Open the default camera
    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        print("Error: Unable to access the camera")
        return

    while True:
        ret, frame = cap.read()
        if not ret:
            break

        # Detect ArUco markers in the frame
        corners, ids, _ = aruco_detector.detectMarkers(frame)
        mask = np.ones(frame.shape[:2], dtype="uint8") * 255
        for corner in corners:
            x_min, y_min, x_max, y_max = expand_roi(corner[0], frame)
            mask[y_min:y_max, x_min:x_max] = 0

        # Calculate scale factor using the first detected ArUco marker
        if ids is not None:
            aruco.drawDetectedMarkers(frame, corners, ids)
            marker_corners = corners[0][0]
            side_length_pixels = np.linalg.norm(marker_corners[0] - marker_corners[1])
            pixel_to_mm = side_length_pixels / 50
        else:
            pixel_to_mm = None

        # Detect and classify needles in the frame
        detect_needles(frame, mask, pixel_to_mm)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
